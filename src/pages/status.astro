---
import Layout from '@/layouts/Layout.astro';
import Freshness from '@/components/Freshness.astro';
import type { CollectionStatus, CompanyProfile } from '@/lib/types';
import statusRaw from '../../public/data/status.json';
import companiesRaw from '../../public/data/companies.json';

const status = statusRaw as CollectionStatus;
const companies = companiesRaw as unknown as CompanyProfile[];
const companyById = new Map(companies.map((company) => [company.id, company]));
const sourceRows = Object.entries(status.companies)
  .map(([id, source]) => ({ id, name: companyById.get(id)?.name ?? id, ...source }))
  .sort((a, b) => Number(b.stale) - Number(a.stale) || a.name.localeCompare(b.name));
const format = (value?: string) => value
  ? new Intl.DateTimeFormat('en-CA', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC' }).format(new Date(value))
  : 'Never';
const base = import.meta.env.BASE_URL;
---

<Layout title="Data health — Hiring Signal Radar" description="Collection freshness and source-level health for Hiring Signal Radar.">
  <div class="page-shell status-page">
    <header class="status-hero">
      <div><p class="eyebrow orange">DATA OPERATIONS</p><h1>Trust the timestamp.</h1><p>Health is reported at two levels: whether each employer board answered during the latest collection, and whether the entire published snapshot is still recent.</p></div>
      <Freshness status={status} />
    </header>
    <section class="status-summary" aria-label="Collection summary">
      <div><span>TRACKING SINCE</span><strong>{status.trackingSince}</strong></div>
      <div><span>LATEST SNAPSHOT</span><strong>{format(status.generatedAt)}</strong></div>
      <div><span>HEALTHY SOURCES</span><strong>{status.healthySources} / {status.totalSources}</strong></div>
      <div><span>STALE SOURCES</span><strong>{status.staleSources}</strong></div>
    </section>
    <section class="source-health" aria-labelledby="source-health-title">
      <div class="section-heading"><div><p class="section-kicker">SOURCE LEDGER</p><h2 id="source-health-title">Board-by-board health.</h2></div><p>This is operational health, not a guarantee that an employer’s board is complete. The site-wide warning appears when the last generated snapshot is more than 48 hours old.</p></div>
      <div class="status-table-wrap">
        <table>
          <thead><tr><th>Employer</th><th>Status</th><th>Last success</th><th>Failures</th></tr></thead>
          <tbody>{sourceRows.map((source) => <tr><td><a href={`${base}companies/${source.id}/`}>{source.name}</a></td><td><span class:list={['health-pill', { stale: source.stale }]}>{source.stale ? 'STALE' : 'REPORTING'}</span></td><td>{format(source.lastSuccess)}</td><td>{source.consecutiveFailures}</td></tr>)}</tbody>
        </table>
      </div>
      <p class="machine-status">Need the machine-readable record? <a href={`${base}data/status.json`}>Open status.json →</a></p>
    </section>
  </div>
</Layout>

<style>
  .status-page { padding-bottom: 80px; }
  .status-hero { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 70px; align-items: end; padding: 78px 0 54px; border-bottom: 1px solid var(--line-strong); }
  .status-hero h1 { margin-bottom: 18px; font-size: clamp(58px, 7vw, 104px); line-height: .88; }
  .status-hero p:not(.eyebrow) { max-width: 680px; color: var(--ink-soft); }
  .status-summary { display: grid; grid-template-columns: repeat(4, 1fr); border-bottom: 1px solid var(--line-strong); }
  .status-summary div { min-height: 118px; padding: 24px; border-right: 1px solid var(--line); }
  .status-summary div:last-child { border-right: 0; }
  .status-summary span { display: block; margin-bottom: 12px; color: var(--ink-soft); font: 500 9px var(--mono); letter-spacing: .1em; }
  .status-summary strong { font: 500 clamp(20px, 2.4vw, 35px) var(--display); }
  .source-health { padding-top: 76px; }
  .status-table-wrap { overflow-x: auto; border: 1px solid var(--line-strong); }
  table { width: 100%; border-collapse: collapse; background: rgba(255,255,255,.2); }
  th, td { padding: 14px 17px; border-bottom: 1px solid var(--line); text-align: left; font-size: 12px; }
  th { background: var(--paper-deep); font: 600 9px var(--mono); letter-spacing: .1em; }
  td:nth-child(n+2) { font-family: var(--mono); font-size: 10px; }
  tbody tr:last-child td { border-bottom: 0; }
  tbody a { font-weight: 600; border-bottom: 1px solid var(--line-strong); }
  .health-pill { display: inline-block; padding: 4px 7px; color: #176d3a; background: rgba(43,157,88,.12); }
  .health-pill.stale { color: #8c2a22; background: rgba(200,63,49,.12); }
  .machine-status { margin-top: 18px; color: var(--ink-soft); font-size: 12px; }
  .machine-status a { color: var(--blue); font-weight: 600; }
  @media (max-width: 800px) { .status-hero { grid-template-columns: 1fr; gap: 25px; } .status-summary { grid-template-columns: 1fr 1fr; } .status-summary div:nth-child(2) { border-right: 0; } }
  @media (max-width: 520px) { .status-summary { grid-template-columns: 1fr; } .status-summary div { border-right: 0; } }
</style>
